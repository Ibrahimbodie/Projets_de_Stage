{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 07 — Analyse des Erreurs\n",
        "**RQ5-6** : Quelles catégories de questions sont les plus difficiles ? Quelles sont les causes d'échec ?\n",
        "\n",
        "Analyse qualitative et quantitative des échecs du RAG."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import sys, os, pandas as pd, numpy as np, matplotlib.pyplot as plt\n",
        "sys.path.insert(0, os.path.abspath(\"..\"))\n",
        "\n",
        "from notebooks.lib.plotter import pareto, barplot\n",
        "from experiments.registry import ExperimentLog\n",
        "\n",
        "# Charger les résultats de l'évaluation complète\n",
        "log = ExperimentLog.load_global_log()\n",
        "print(f\"Runs disponibles : {len(log)}\")\n",
        "for r in log:\n",
        "    print(f\"  {r['timestamp']} — {r['experiment']}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Charger les résultats DeepEval les plus récents\n",
        "import glob, json\n",
        "json_files = sorted(glob.glob(\"../outputs/json/*.json\"), reverse=True)\n",
        "if not json_files:\n",
        "    print(\"Aucun résultat trouvé. Lancez d'abord le notebook 06.\")\n",
        "else:\n",
        "    with open(json_files[0]) as f:\n",
        "        data = json.load(f)\n",
        "    df = pd.DataFrame(data['results'])\n",
        "    print(f\"Chargé : {json_files[0]}\")\n",
        "    print(f\"{len(df)} résultats\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Identifier les échecs\n",
        "threshold = 0.75\n",
        "df['echoue'] = (\n",
        "    (df['faithfulness'] < threshold) |\n",
        "    (df['answer_relevancy'] < threshold)\n",
        ")\n",
        "echecs = df[df['echoue']]\n",
        "print(f\"Questions en échec : {len(echecs)}/{len(df)} ({len(echecs)/len(df)*100:.1f}%)\")\n",
        "print()\n",
        "\n",
        "# Distribution par niveau\n",
        "print(\"=== Échecs par Niveau ===\")\n",
        "print(echecs['niveau'].value_counts())\n",
        "print()\n",
        "\n",
        "# Distribution par catégorie\n",
        "print(\"=== Échecs par Catégorie ===\")\n",
        "print(echecs['categorie'].value_counts())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Classification automatique des causes d'échec\n",
        "def classer_erreur(row):\n",
        "    if row['num_chunks'] == 0:\n",
        "        return \"Aucun document récupéré (échec retrieval)\"\n",
        "    if row['faithfulness'] < threshold:\n",
        "        return \"Hallucination (faible fidélité)\"\n",
        "    if row['answer_relevancy'] < threshold:\n",
        "        return "Réponse non pertinente"\n",
        "    if row['contextual_recall'] < threshold:\n",
        "        return \"Contexte insuffisant (faible rappel)\"\n",
        "    return \"Passé\"\n",
        "\n",
        "if not df.empty:\n",
        "    df['cause_erreur'] = df.apply(classer_erreur, axis=1)\n",
        "    print(\"=== Causes d'échec (Diagramme de Pareto) ===\")\n",
        "    print(df['cause_erreur'].value_counts())\n",
        "\n",
        "    pareto(df['cause_erreur'],\n",
        "           title=\"Causes d'échec du pipeline RAG\",\n",
        "           filename='error_pareto.png')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Analyse détaillée des questions échouées\n",
        "if len(echecs) > 0:\n",
        "    print(\"=== Questions en échec ===\")\n",
        "    for _, r in echecs.iterrows():\n",
        "        print(f\"\\n[{r['ID']}] ({r['niveau']}) {r['question'][:100]}...\")\n",
        "        print(f\"  Faithfulness={r['faithfulness']:.3f}\")\n",
        "        print(f"  Relevancy={r['answer_relevancy']:.3f}\")\n",
        "        print(f\"  Recall={r['contextual_recall']:.3f}\")\n",
        "        print(f\"  Chunks={r['num_chunks']}\")\n",
        "\n",
        "print()\n",
        "print(\"Analyse sauvegardée dans outputs/json/error_analysis.json\")\n",
        "\n",
        "# Sauvegarde\n",
        "from notebooks.lib.reporter import to_json, to_excel\n",
        "if not df.empty:\n",
        "    to_json(df.to_dict('records'), 'error_analysis')\n",
        "    to_excel(df.to_dict('records'), 'error_analysis')"
      ]
    }
  ],
